# Machine-specific paths for tc-argo pipeline
# Copy this file to .env and edit for your machine.
# These are read by current_settings.py via os.environ.get()

# Root directory for all pipeline data (Argo DAC files, TC tracks, run outputs)
# Titan:    /media/brandon/data_drive/tc_argo_data/
# Europa:   /media/brandon/data_drive/tc_argo_data/
# Callisto: (set your path here)
STORAGE_WD=/media/brandon/data_drive/tc_argo_data/

# Path to MATLAB engine for Python (installed in conda env site-packages)
# Only needed if running MATLAB A-series scripts via Python subprocess
# Install: cd <MATLAB_ROOT>/extern/engines/python && python setup.py install
# Example: /home/brandon/anaconda3/envs/argo/lib/python3.10/site-packages/matlabengineforpython-9.13-py3.10.egg/matlab/
MATLAB_ENGINE_PATH=
